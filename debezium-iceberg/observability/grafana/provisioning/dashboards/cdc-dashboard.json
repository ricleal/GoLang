{
  "uid": "cdc-stand",
  "title": "CDC Stand: Postgres \u2192 Debezium \u2192 Iceberg",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Replication lag (ms)",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(debezium_metrics_MilliSecondsBehindSource{context=\"streaming\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Max table freshness (s)",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(dq_freshness_seconds)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed DQ checks",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(dq_check_ok == 0) or vector(0)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CDC events/sec",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(debezium_metrics_TotalNumberOfEventsSeen{context=\"streaming\"}[1m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Rowcount diff (pg vs iceberg live)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dq_rowcount_diff",
          "legendFormat": "{{table}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Null rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dq_null_rate",
          "legendFormat": "{{table}}.{{column}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "DQ cycle errors",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(dq_cycle_errors_total[5m])"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "PK duplicates (live rows sharing a key)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dq_duplicate_pk_rows"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Keys missing from the lake",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dq_missing_keys",
          "legendFormat": "missing: {{table}}"
        },
        {
          "refId": "B",
          "expr": "dq_extra_keys",
          "legendFormat": "extra: {{table}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "DQ cycles/sec (flat line = runner stalled)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(dq_cycles_total[5m])"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Rowcounts (source vs iceberg live)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dq_rowcount_source",
          "legendFormat": "source: {{table}}"
        },
        {
          "refId": "B",
          "expr": "dq_rowcount_iceberg",
          "legendFormat": "iceberg: {{table}}"
        }
      ]
    }
  ]
}
