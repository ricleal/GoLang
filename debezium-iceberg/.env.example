# MinIO (change in sync with lakekeeper/create-warehouse.json and debezium/application.properties)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
# Internal Postgres (Lakekeeper + Marquez)
META_PG_USER=lakekeeper
META_PG_PASSWORD=lakekeeper
# CDC source (change in sync with debezium/application.properties: the connector
# credentials are hardcoded there, and CDC stops silently if the two disagree)
SOURCE_PG_USER=postgres
SOURCE_PG_PASSWORD=postgres
# Change generator
DATAGEN_INTERVAL_SECONDS=2
# optional: reproducible generator (same seed -> same data sequence)
# DATAGEN_SEED=12345
# DQ runner
DQ_INTERVAL_SECONDS=30
DQ_ROWCOUNT_TOLERANCE=25
DQ_FRESHNESS_MAX_SECONDS=120
DQ_NULL_CHECKS=inventory.customers:email
# Table maintenance (`make maintain`)
MAINT_MAX_AGE_HOURS=2
MAINT_RETAIN_LAST=20
